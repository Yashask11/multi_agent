# ============================================================
# Multi-Agent System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#
# The system works with ANY OpenAI-compatible API provider.
# Below are pre-configured examples for free options.
# ============================================================

# --- OPTION 1: Groq (FREE — no credit card needed) ----------
# Sign up at https://console.groq.com  →  API Keys  →  Create
LLM_API_KEY=gsk_your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- OPTION 2: Google Gemini (FREE tier available) -----------
# Get key at https://aistudio.google.com/apikey
# LLM_API_KEY=your-gemini-api-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- OPTION 3: OpenAI (paid) --------------------------------
# Get key at https://platform.openai.com/api-keys
# LLM_API_KEY=sk-your-openai-key-here
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
